/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kuwala-books",
	"account_id": "7c64f94b6e4b44f69518798fd6f1ee58",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./src/server.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Escrow auto-release, stale payment checks and payout reconciliation (src/server/jobs.server.ts).
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	/**
	 * Non-secret config. Locally, .dev.vars overrides these (see .dev.vars.example).
	 * Secrets are set with `wrangler secret put <NAME>`:
	 *   DATABASE_URL, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, LENCO_PUBLIC_KEY,
	 *   LENCO_API_SECRET_KEY, LENCO_WEBHOOK_HASH_KEY, LENCO_PAYOUT_ACCOUNT_ID,
	 *   GOOGLE_BOOKS_API_KEY, RESEND_API_KEY
	 */
	"vars": {
		"APP_ORIGIN": "https://kuwalabooks.com",
		// Admin pages only render on this host (src/routes/admin.tsx).
		"ADMIN_ORIGIN": "https://admin.kuwalabooks.com",
		"EMAIL_FROM": "Kuwala Books <orders@kuwalabooks.com>",
		// Live Lenco API. Set "true" only alongside sandbox keys.
		"LENCO_SANDBOX": "false"
	},
	// Warm connections to Supabase (session pooler, caching off: order and payment reads must never be stale).
	// Local dev connects directly via CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in .env.
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "f6e17abe3de147e6914c305c90466564" }],
	// Seller-photographed covers, served through the Worker at /covers/<key> (src/routes/covers.$key.ts).
	"r2_buckets": [{ "binding": "COVERS", "bucket_name": "kuwala-covers" }],
	// www redirects to the apex in src/server.ts.
	"routes": [
		{ "pattern": "kuwalabooks.com", "custom_domain": true },
		{ "pattern": "www.kuwalabooks.com", "custom_domain": true },
		{ "pattern": "admin.kuwalabooks.com", "custom_domain": true }
	]
}
